{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "growlogue-ai",
  "main": "src/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "AI_ENABLED": "false",
    "AI_MODEL": "gpt-5.6-luna"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
