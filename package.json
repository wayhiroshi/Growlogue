{
  "name": "growlogue",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm --filter @growlogue/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "pnpm --filter @growlogue/db generate",
    "db:migrate:local": "pnpm --filter @growlogue/web db:migrate:local",
    "cf:typegen": "pnpm --filter @growlogue/web cf:typegen",
    "preview": "pnpm --filter @growlogue/web preview",
    "deploy": "pnpm --filter @growlogue/web deploy"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.62.0",
    "@types/node": "24.10.1",
    "eslint": "9.39.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
